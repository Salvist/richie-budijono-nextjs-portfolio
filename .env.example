# Resend API key — create a free account at https://resend.com,
# generate an API key, and paste it here (and in your Vercel project settings).
RESEND_API_KEY=

# Optional: the "from" address for contact-form emails.
# Defaults to onboarding@resend.dev (works without domain verification).
# Once you verify richiebudijono.com in Resend, use e.g. "Richie Budijono <contact@richiebudijono.com>".
CONTACT_FROM_EMAIL=
